<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_deep"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="16dp"
        android:paddingTop="20dp"
        android:paddingBottom="32dp">

        <!-- Header -->
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="Settings" android:textSize="24sp" android:textStyle="bold"
            android:textColor="@color/text_primary" android:layout_marginBottom="4dp" />
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="Manage your Animal Alert preferences"
            android:textSize="12sp" android:textColor="@color/text_muted"
            android:layout_marginBottom="24dp" />

        <!-- ── APPEARANCE ───────────── -->
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="APPEARANCE" android:textSize="10sp" android:textStyle="bold"
            android:textColor="@color/accent" android:letterSpacing="0.15"
            android:layout_marginBottom="8dp" />

        <androidx.cardview.widget.CardView android:layout_width="match_parent"
            android:layout_height="wrap_content" android:layout_marginBottom="20dp"
            app:cardCornerRadius="14dp" app:cardElevation="0dp"
            app:cardBackgroundColor="@color/bg_card2">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="vertical">

                <LinearLayout android:layout_width="match_parent" android:layout_height="56dp"
                    android:orientation="horizontal" android:gravity="center_vertical"
                    android:paddingHorizontal="16dp" android:background="?attr/selectableItemBackground">
                    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                        android:layout_weight="1" android:orientation="vertical">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="Dark Mode" android:textSize="14sp" android:textColor="@color/text_primary" />
                    </LinearLayout>
                    <com.google.android.material.switchmaterial.SwitchMaterial
                        android:id="@+id/switchDarkMode" android:layout_width="wrap_content"
                        android:layout_height="wrap_content" android:checked="true" />
                </LinearLayout>
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- ── NOTIFICATIONS ────────── -->
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="NOTIFICATIONS" android:textSize="10sp" android:textStyle="bold"
            android:textColor="@color/accent" android:letterSpacing="0.15"
            android:layout_marginBottom="8dp" />

        <androidx.cardview.widget.CardView android:layout_width="match_parent"
            android:layout_height="wrap_content" android:layout_marginBottom="20dp"
            app:cardCornerRadius="14dp" app:cardElevation="0dp"
            app:cardBackgroundColor="@color/bg_card2">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="vertical">

                <!-- Push -->
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="horizontal" android:gravity="center_vertical"
                    android:paddingHorizontal="16dp" android:paddingVertical="12dp"
                    android:background="?attr/selectableItemBackground">
                    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                        android:layout_weight="1" android:orientation="vertical">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="Push Notifications" android:textSize="14sp"
                            android:textColor="@color/text_primary" />
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="Receive alerts when animal is detected" android:textSize="11sp"
                            android:textColor="@color/text_muted" android:layout_marginTop="1dp" />
                    </LinearLayout>
                    <com.google.android.material.switchmaterial.SwitchMaterial
                        android:id="@+id/switchPushNotifications" android:layout_width="wrap_content"
                        android:layout_height="wrap_content" />
                </LinearLayout>

                <View android:layout_width="match_parent" android:layout_height="1dp"
                    android:background="@color/border" android:layout_marginHorizontal="16dp" />

                <!-- Email -->
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="horizontal" android:gravity="center_vertical"
                    android:paddingHorizontal="16dp" android:paddingVertical="12dp"
                    android:background="?attr/selectableItemBackground">
                    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                        android:layout_weight="1" android:orientation="vertical">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="Email Alerts" android:textSize="14sp"
                            android:textColor="@color/text_primary" />
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="Send detection report to your email" android:textSize="11sp"
                            android:textColor="@color/text_muted" android:layout_marginTop="1dp" />
                    </LinearLayout>
                    <com.google.android.material.switchmaterial.SwitchMaterial
                        android:id="@+id/switchEmailNotifications" android:layout_width="wrap_content"
                        android:layout_height="wrap_content" />
                </LinearLayout>

                <View android:layout_width="match_parent" android:layout_height="1dp"
                    android:background="@color/border" android:layout_marginHorizontal="16dp" />

                <!-- SMS -->
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="horizontal" android:gravity="center_vertical"
                    android:paddingHorizontal="16dp" android:paddingVertical="12dp"
                    android:background="?attr/selectableItemBackground">
                    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                        android:layout_weight="1" android:orientation="vertical">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="SMS Alerts" android:textSize="14sp"
                            android:textColor="@color/text_primary" />
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="Send SMS to emergency contact" android:textSize="11sp"
                            android:textColor="@color/text_muted" android:layout_marginTop="1dp" />
                    </LinearLayout>
                    <com.google.android.material.switchmaterial.SwitchMaterial
                        android:id="@+id/switchSmsNotifications" android:layout_width="wrap_content"
                        android:layout_height="wrap_content" />
                </LinearLayout>

                <View android:layout_width="match_parent" android:layout_height="1dp"
                    android:background="@color/border" android:layout_marginHorizontal="16dp" />

                <!-- Sound -->
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="horizontal" android:gravity="center_vertical"
                    android:paddingHorizontal="16dp" android:paddingVertical="12dp"
                    android:background="?attr/selectableItemBackground">
                    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                        android:layout_weight="1" android:orientation="vertical">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="In-App Sound" android:textSize="14sp"
                            android:textColor="@color/text_primary" />
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="Play siren sound on detection" android:textSize="11sp"
                            android:textColor="@color/text_muted" android:layout_marginTop="1dp" />
                    </LinearLayout>
                    <com.google.android.material.switchmaterial.SwitchMaterial
                        android:id="@+id/switchInAppSound" android:layout_width="wrap_content"
                        android:layout_height="wrap_content" />
                </LinearLayout>
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- ── ALERT SYSTEM ──────────── -->
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="ALERT SYSTEM" android:textSize="10sp" android:textStyle="bold"
            android:textColor="@color/accent" android:letterSpacing="0.15"
            android:layout_marginBottom="8dp" />

        <androidx.cardview.widget.CardView android:layout_width="match_parent"
            android:layout_height="wrap_content" android:layout_marginBottom="20dp"
            app:cardCornerRadius="14dp" app:cardElevation="0dp"
            app:cardBackgroundColor="@color/bg_card2">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="vertical">

                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="horizontal" android:gravity="center_vertical"
                    android:paddingHorizontal="16dp" android:paddingVertical="12dp">
                    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                        android:layout_weight="1" android:orientation="vertical">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="Auto-Start Monitoring" android:textSize="14sp"
                            android:textColor="@color/text_primary" />
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="Start alert service when app opens" android:textSize="11sp"
                            android:textColor="@color/text_muted" android:layout_marginTop="1dp" />
                    </LinearLayout>
                    <com.google.android.material.switchmaterial.SwitchMaterial
                        android:id="@+id/switchAutoStart" android:layout_width="wrap_content"
                        android:layout_height="wrap_content" android:checked="true" />
                </LinearLayout>

                <View android:layout_width="match_parent" android:layout_height="1dp"
                    android:background="@color/border" android:layout_marginHorizontal="16dp" />

                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="horizontal" android:gravity="center_vertical"
                    android:paddingHorizontal="16dp" android:paddingVertical="12dp">
                    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                        android:layout_weight="1" android:orientation="vertical">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="Danger Animals Only" android:textSize="14sp"
                            android:textColor="@color/text_primary" />
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="Alert only for high-danger detections" android:textSize="11sp"
                            android:textColor="@color/text_muted" android:layout_marginTop="1dp" />
                    </LinearLayout>
                    <com.google.android.material.switchmaterial.SwitchMaterial
                        android:id="@+id/switchDangerOnly" android:layout_width="wrap_content"
                        android:layout_height="wrap_content" />
                </LinearLayout>

                <View android:layout_width="match_parent" android:layout_height="1dp"
                    android:background="@color/border" android:layout_marginHorizontal="16dp" />

                <!-- Confidence threshold -->
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="vertical" android:paddingHorizontal="16dp"
                    android:paddingTop="14dp" android:paddingBottom="14dp">
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:orientation="horizontal">
                        <TextView android:layout_width="0dp" android:layout_height="wrap_content"
                            android:layout_weight="1" android:text="Confidence Threshold"
                            android:textSize="14sp" android:textColor="@color/text_primary" />
                        <TextView android:id="@+id/tvConfidenceValue"
                            android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="60%" android:textSize="14sp" android:textStyle="bold"
                            android:textColor="@color/accent" />
                    </LinearLayout>
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="Minimum confidence to trigger alert"
                        android:textSize="11sp" android:textColor="@color/text_muted"
                        android:layout_marginTop="2dp" android:layout_marginBottom="8dp" />
                    <SeekBar android:id="@+id/seekConfidence"
                        android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:max="100" android:progress="60" />
                </LinearLayout>

                <View android:layout_width="match_parent" android:layout_height="1dp"
                    android:background="@color/border" android:layout_marginHorizontal="16dp" />

                <!-- Poll interval -->
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="vertical" android:paddingHorizontal="16dp"
                    android:paddingTop="14dp" android:paddingBottom="14dp">
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:orientation="horizontal">
                        <TextView android:layout_width="0dp" android:layout_height="wrap_content"
                            android:layout_weight="1" android:text="Polling Interval"
                            android:textSize="14sp" android:textColor="@color/text_primary" />
                        <TextView android:id="@+id/tvPollIntervalValue"
                            android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="3s" android:textSize="14sp" android:textStyle="bold"
                            android:textColor="@color/accent" />
                    </LinearLayout>
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="How often to check for new detections (1–10 s)"
                        android:textSize="11sp" android:textColor="@color/text_muted"
                        android:layout_marginTop="2dp" android:layout_marginBottom="8dp" />
                    <SeekBar android:id="@+id/seekPollInterval"
                        android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:max="9" android:progress="2" />
                </LinearLayout>

                <View android:layout_width="match_parent" android:layout_height="1dp"
                    android:background="@color/border" android:layout_marginHorizontal="16dp" />

                <!-- Personal Focus Camera (Local) -->
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="vertical" android:paddingHorizontal="16dp"
                    android:paddingTop="14dp" android:paddingBottom="14dp">
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:text="Personal Focus Camera (Local)"
                        android:textSize="14sp" android:textColor="@color/text_primary" />
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:text="Filter alert feed and warnings for this session"
                        android:textSize="11sp" android:textColor="@color/text_muted"
                        android:layout_marginTop="2dp" android:layout_marginBottom="8dp" />
                    <androidx.appcompat.widget.AppCompatSpinner
                        android:id="@+id/spinnerFocusCamera"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:backgroundTint="@color/accent"
                        android:spinnerMode="dropdown" />
                </LinearLayout>

                <View android:layout_width="match_parent" android:layout_height="1dp"
                    android:background="@color/border" android:layout_marginHorizontal="16dp" />

                <!-- Global Primary Camera (Server-Wide) -->
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="vertical" android:paddingHorizontal="16dp"
                    android:paddingTop="14dp" android:paddingBottom="14dp">
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:text="Global Primary Camera (Server-Wide)"
                        android:textSize="14sp" android:textColor="@color/text_primary" />
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:text="Update primary active camera for all passive operators"
                        android:textSize="11sp" android:textColor="@color/text_muted"
                        android:layout_marginTop="2dp" android:layout_marginBottom="8dp" />
                    <androidx.appcompat.widget.AppCompatSpinner
                        android:id="@+id/spinnerGlobalPrimaryCamera"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:backgroundTint="@color/accent"
                        android:spinnerMode="dropdown" />
                </LinearLayout>
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- ── MAP ───────────────────── -->
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="MAP" android:textSize="10sp" android:textStyle="bold"
            android:textColor="@color/accent" android:letterSpacing="0.15"
            android:layout_marginBottom="8dp" />

        <androidx.cardview.widget.CardView android:layout_width="match_parent"
            android:layout_height="wrap_content" android:layout_marginBottom="20dp"
            app:cardCornerRadius="14dp" app:cardElevation="0dp"
            app:cardBackgroundColor="@color/bg_card2">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="vertical">

                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="horizontal" android:gravity="center_vertical"
                    android:paddingHorizontal="16dp" android:paddingVertical="12dp">
                    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                        android:layout_weight="1" android:orientation="vertical">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="Show All History on Map" android:textSize="14sp"
                            android:textColor="@color/text_primary" />
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="Plot past detections on the map" android:textSize="11sp"
                            android:textColor="@color/text_muted" android:layout_marginTop="1dp" />
                    </LinearLayout>
                    <com.google.android.material.switchmaterial.SwitchMaterial
                        android:id="@+id/switchShowHistory" android:layout_width="wrap_content"
                        android:layout_height="wrap_content" android:checked="true" />
                </LinearLayout>

                <View android:layout_width="match_parent" android:layout_height="1dp"
                    android:background="@color/border" android:layout_marginHorizontal="16dp" />

                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="horizontal" android:gravity="center_vertical"
                    android:paddingHorizontal="16dp" android:paddingVertical="12dp">
                    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                        android:layout_weight="1" android:orientation="vertical">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="Auto-Center on Location" android:textSize="14sp"
                            android:textColor="@color/text_primary" />
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="Center map on your GPS position" android:textSize="11sp"
                            android:textColor="@color/text_muted" android:layout_marginTop="1dp" />
                    </LinearLayout>
                    <com.google.android.material.switchmaterial.SwitchMaterial
                        android:id="@+id/switchAutoCenter" android:layout_width="wrap_content"
                        android:layout_height="wrap_content" android:checked="true" />
                </LinearLayout>
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- ── DATA AND PRIVACY ──────── -->
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="DATA AND PRIVACY" android:textSize="10sp" android:textStyle="bold"
            android:textColor="@color/accent" android:letterSpacing="0.15"
            android:layout_marginBottom="8dp" />

        <androidx.cardview.widget.CardView android:layout_width="match_parent"
            android:layout_height="wrap_content" android:layout_marginBottom="20dp"
            app:cardCornerRadius="14dp" app:cardElevation="0dp"
            app:cardBackgroundColor="@color/bg_card2">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="vertical">

                <!-- Server URL -->
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="vertical" android:paddingHorizontal="16dp"
                    android:paddingTop="14dp" android:paddingBottom="14dp">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="Detection Server URL" android:textSize="14sp"
                        android:textColor="@color/text_primary" android:layout_marginBottom="8dp" />
                    <com.google.android.material.textfield.TextInputLayout
                        android:layout_width="match_parent" android:layout_height="wrap_content"
                        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox.Dense"
                        app:boxStrokeColor="@color/accent" app:hintTextColor="@color/text_muted">
                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/etServerUrl" android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:hint="e.g. http://192.168.1.10:5000"
                            android:inputType="textUri" android:singleLine="true"
                            android:textColor="@color/text_primary" />
                    </com.google.android.material.textfield.TextInputLayout>
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnSaveServerUrl" android:layout_width="wrap_content"
                        android:layout_height="wrap_content" android:layout_marginTop="8dp"
                        android:text="Save" android:textColor="@color/accent"
                        android:backgroundTint="@color/bg_card3" app:cornerRadius="8dp"
                        style="@style/Widget.MaterialComponents.Button" />
                </LinearLayout>

                <View android:layout_width="match_parent" android:layout_height="1dp"
                    android:background="@color/border" android:layout_marginHorizontal="16dp" />

                <!-- Clear history -->
                <LinearLayout android:id="@+id/rowClearHistory"
                    android:layout_width="match_parent" android:layout_height="54dp"
                    android:orientation="horizontal" android:gravity="center_vertical"
                    android:paddingHorizontal="16dp" android:background="?attr/selectableItemBackground">
                    <TextView android:layout_width="0dp" android:layout_height="wrap_content"
                        android:layout_weight="1" android:text="Clear Detection History"
                        android:textSize="14sp" android:textColor="@color/danger" />
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="›" android:textSize="20sp" android:textColor="@color/text_muted" />
                </LinearLayout>
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- ── ABOUT ──────────────────── -->
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="ABOUT" android:textSize="10sp" android:textStyle="bold"
            android:textColor="@color/accent" android:letterSpacing="0.15"
            android:layout_marginBottom="8dp" />

        <androidx.cardview.widget.CardView android:layout_width="match_parent"
            android:layout_height="wrap_content" android:layout_marginBottom="8dp"
            app:cardCornerRadius="14dp" app:cardElevation="0dp"
            app:cardBackgroundColor="@color/bg_card2">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="vertical">

                <LinearLayout android:layout_width="match_parent" android:layout_height="54dp"
                    android:orientation="horizontal" android:gravity="center_vertical"
                    android:paddingHorizontal="16dp">
                    <TextView android:layout_width="0dp" android:layout_height="wrap_content"
                        android:layout_weight="1" android:text="App Version"
                        android:textSize="14sp" android:textColor="@color/text_primary" />
                    <TextView android:id="@+id/tvAppVersion"
                        android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="1.0.0" android:textSize="12sp" android:textColor="@color/text_muted" />
                </LinearLayout>

                <View android:layout_width="match_parent" android:layout_height="1dp"
                    android:background="@color/border" android:layout_marginHorizontal="16dp" />

                <LinearLayout android:id="@+id/rowHelp"
                    android:layout_width="match_parent" android:layout_height="54dp"
                    android:orientation="horizontal" android:gravity="center_vertical"
                    android:paddingHorizontal="16dp" android:background="?attr/selectableItemBackground">
                    <TextView android:layout_width="0dp" android:layout_height="wrap_content"
                        android:layout_weight="1" android:text="Help and Support"
                        android:textSize="14sp" android:textColor="@color/text_primary" />
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="›" android:textSize="20sp" android:textColor="@color/text_muted" />
                </LinearLayout>

                <View android:layout_width="match_parent" android:layout_height="1dp"
                    android:background="@color/border" android:layout_marginHorizontal="16dp" />

                <LinearLayout android:id="@+id/rowEmergencyContacts"
                    android:layout_width="match_parent" android:layout_height="54dp"
                    android:orientation="horizontal" android:gravity="center_vertical"
                    android:paddingHorizontal="16dp" android:background="?attr/selectableItemBackground">
                    <TextView android:layout_width="0dp" android:layout_height="wrap_content"
                        android:layout_weight="1" android:text="Emergency Contacts"
                        android:textSize="14sp" android:textColor="@color/text_primary" />
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="›" android:textSize="20sp" android:textColor="@color/text_muted" />
                </LinearLayout>

                <View android:layout_width="match_parent" android:layout_height="1dp"
                    android:background="@color/border" android:layout_marginHorizontal="16dp" />

                <LinearLayout android:id="@+id/rowLogout"
                    android:layout_width="match_parent" android:layout_height="54dp"
                    android:orientation="horizontal" android:gravity="center_vertical"
                    android:paddingHorizontal="16dp" android:background="?attr/selectableItemBackground">
                    <TextView android:layout_width="0dp" android:layout_height="wrap_content"
                        android:layout_weight="1" android:text="Logout"
                        android:textSize="14sp" android:textColor="@color/danger" />
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="›" android:textSize="20sp" android:textColor="@color/text_muted" />
                </LinearLayout>
            </LinearLayout>
        </androidx.cardview.widget.CardView>

    </LinearLayout>
</ScrollView>
