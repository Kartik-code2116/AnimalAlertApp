<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_deep"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- ── PROFILE HEADER ─────────────────────────────── -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center"
            android:paddingTop="36dp"
            android:paddingBottom="24dp"
            android:background="@drawable/gradient_background">

            <!-- Avatar -->
            <androidx.cardview.widget.CardView
                android:layout_width="84dp"
                android:layout_height="84dp"
                app:cardCornerRadius="42dp"
                app:cardBackgroundColor="@color/bg_card"
                app:cardElevation="8dp"
                android:layout_marginBottom="16dp">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center">
                    <ImageView
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:src="@drawable/ic_profile"
                        app:tint="@color/accent" />
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <TextView
                android:id="@+id/tvUserName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="User Name"
                android:textColor="@color/text_primary"
                android:textSize="22sp"
                android:textStyle="bold"
                android:letterSpacing="0.02"
                android:layout_marginBottom="4dp" />

            <TextView
                android:id="@+id/tvUserEmail"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="user@example.com"
                android:textSize="13sp"
                android:textColor="@color/text_secondary"
                android:layout_marginBottom="16dp" />

            <!-- Role badge -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:background="@drawable/card_border_accent"
                android:paddingHorizontal="16dp"
                android:paddingVertical="6dp"
                android:layout_marginBottom="24dp">

                <View android:layout_width="8dp" android:layout_height="8dp"
                    android:background="@drawable/ic_circle_green" android:layout_marginEnd="8dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="FIELD OPERATOR"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:textColor="@color/accent"
                    android:letterSpacing="0.15" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnEditProfile"
                    android:layout_width="wrap_content"
                    android:layout_height="44dp"
                    android:layout_marginEnd="8dp"
                    android:text="Edit Profile"
                    android:textSize="13sp"
                    android:textColor="@color/text_primary"
                    android:backgroundTint="#242B38"
                    app:cornerRadius="22dp"
                    style="@style/Widget.MaterialComponents.Button" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnSettings"
                    android:layout_width="wrap_content"
                    android:layout_height="44dp"
                    android:layout_marginStart="8dp"
                    app:icon="@drawable/ic_dashboard"
                    app:iconGravity="textStart"
                    app:iconTint="@color/text_primary"
                    android:text="Settings"
                    android:textSize="13sp"
                    android:textColor="@color/text_primary"
                    android:backgroundTint="#242B38"
                    app:cornerRadius="22dp"
                    style="@style/Widget.MaterialComponents.Button" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- ── NOTIFICATIONS SECTION ───────────────────── -->
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="horizontal" android:gravity="center_vertical"
                android:layout_marginBottom="8dp">
                <View android:layout_width="3dp" android:layout_height="14dp"
                    android:background="@color/accent" android:layout_marginEnd="8dp" />
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="NOTIFICATIONS" android:textSize="10sp" android:textStyle="bold"
                    android:textColor="@color/accent" android:letterSpacing="0.15" />
            </LinearLayout>

            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="18dp"
                app:cardBackgroundColor="@color/bg_card2"
                app:cardCornerRadius="14dp"
                app:cardElevation="0dp">

                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <!-- In-App -->
                    <LinearLayout android:layout_width="match_parent" android:layout_height="52dp"
                        android:orientation="horizontal" android:gravity="center_vertical"
                        android:paddingHorizontal="16dp">
                        <LinearLayout android:layout_width="28dp" android:layout_height="28dp"
                            android:gravity="center" android:background="@drawable/card_border_danger"
                            android:layout_marginEnd="12dp">
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                                android:text="🔔" android:textSize="13sp" />
                        </LinearLayout>
                        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                            android:layout_weight="1" android:orientation="vertical">
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                                android:text="In-App Alerts" android:textSize="14sp"
                                android:textStyle="bold" android:textColor="@color/text_primary" />
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                                android:text="Push notifications" android:textSize="11sp"
                                android:textColor="@color/text_muted" />
                        </LinearLayout>
                        <androidx.appcompat.widget.SwitchCompat
                            android:id="@+id/switchInAppNotifications"
                            android:layout_width="wrap_content" android:layout_height="wrap_content" />
                    </LinearLayout>

                    <View android:layout_width="match_parent" android:layout_height="1dp"
                        android:background="@color/border" android:layout_marginHorizontal="16dp" />

                    <!-- SMS -->
                    <LinearLayout android:layout_width="match_parent" android:layout_height="52dp"
                        android:orientation="horizontal" android:gravity="center_vertical"
                        android:paddingHorizontal="16dp">
                        <LinearLayout android:layout_width="28dp" android:layout_height="28dp"
                            android:gravity="center" android:background="@drawable/card_border_default"
                            android:layout_marginEnd="12dp">
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                                android:text="💬" android:textSize="13sp" />
                        </LinearLayout>
                        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                            android:layout_weight="1" android:orientation="vertical">
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                                android:text="SMS Alerts" android:textSize="14sp"
                                android:textStyle="bold" android:textColor="@color/text_primary" />
                            <TextView android:id="@+id/tvUserPhone"
                                android:layout_width="wrap_content" android:layout_height="wrap_content"
                                android:text="+1234567890" android:textSize="11sp"
                                android:textColor="@color/text_muted" />
                        </LinearLayout>
                        <androidx.appcompat.widget.SwitchCompat
                            android:id="@+id/switchSmsNotifications"
                            android:layout_width="wrap_content" android:layout_height="wrap_content" />
                    </LinearLayout>

                    <View android:layout_width="match_parent" android:layout_height="1dp"
                        android:background="@color/border" android:layout_marginHorizontal="16dp" />

                    <!-- Email -->
                    <LinearLayout android:layout_width="match_parent" android:layout_height="52dp"
                        android:orientation="horizontal" android:gravity="center_vertical"
                        android:paddingHorizontal="16dp">
                        <LinearLayout android:layout_width="28dp" android:layout_height="28dp"
                            android:gravity="center" android:background="@drawable/card_border_accent"
                            android:layout_marginEnd="12dp">
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                                android:text="📧" android:textSize="13sp" />
                        </LinearLayout>
                        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                            android:layout_weight="1" android:orientation="vertical">
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                                android:text="Email Alerts" android:textSize="14sp"
                                android:textStyle="bold" android:textColor="@color/text_primary" />
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                                android:text="Detection reports via email" android:textSize="11sp"
                                android:textColor="@color/text_muted" />
                        </LinearLayout>
                        <androidx.appcompat.widget.SwitchCompat
                            android:id="@+id/switchEmailNotifications"
                            android:layout_width="wrap_content" android:layout_height="wrap_content" />
                    </LinearLayout>

                    <!-- Master notifications toggle (hidden but used by code) -->
                    <androidx.appcompat.widget.SwitchCompat
                        android:id="@+id/switchNotifications"
                        android:layout_width="wrap_content" android:layout_height="0dp"
                        android:visibility="gone" />
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- ── DETECTION STATS ─────────────────────────── -->
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="horizontal" android:gravity="center_vertical"
                android:layout_marginBottom="8dp">
                <View android:layout_width="3dp" android:layout_height="14dp"
                    android:background="@color/accent" android:layout_marginEnd="8dp" />
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="DETECTION STATISTICS" android:textSize="10sp" android:textStyle="bold"
                    android:textColor="@color/accent" android:letterSpacing="0.15" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:weightSum="2"
                android:layout_marginBottom="18dp">
    
                <androidx.cardview.widget.CardView
                    android:layout_width="0dp"
                    android:layout_height="90dp"
                    android:layout_weight="1"
                    android:layout_marginEnd="6dp"
                    app:cardBackgroundColor="@color/bg_card2"
                    app:cardCornerRadius="14dp"
                    app:cardElevation="2dp">
                    <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent"
                        android:gravity="center" android:orientation="vertical">
                        <TextView android:id="@+id/tvTodayDetections"
                            android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="0" android:textSize="32sp" android:textStyle="bold"
                            android:textColor="@color/accent" />
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="Today" android:textSize="12sp" android:textColor="@color/text_muted" />
                    </LinearLayout>
                </androidx.cardview.widget.CardView>

                <androidx.cardview.widget.CardView
                    android:layout_width="0dp"
                    android:layout_height="90dp"
                    android:layout_weight="1"
                    android:layout_marginStart="6dp"
                    app:cardBackgroundColor="@color/bg_card2"
                    app:cardCornerRadius="14dp"
                    app:cardElevation="2dp">
                    <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent"
                        android:gravity="center" android:orientation="vertical">
                        <TextView android:id="@+id/tvTotalDetections"
                            android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="0" android:textSize="32sp" android:textStyle="bold"
                            android:textColor="@color/blue" />
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="Total" android:textSize="12sp" android:textColor="@color/text_muted" />
                    </LinearLayout>
                </androidx.cardview.widget.CardView>
            </LinearLayout>

            <!-- Refresh -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnRefreshStats"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:text="Refresh Statistics"
                android:textSize="13sp"
                android:textColor="@color/text_secondary"
                android:backgroundTint="@color/bg_card3"
                app:cornerRadius="10dp"
                style="@style/Widget.MaterialComponents.Button"
                android:layout_marginBottom="18dp" />

            <!-- ── LAST LOGIN ───────────────────────────────── -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="18dp"
                app:cardBackgroundColor="@color/bg_card2"
                app:cardCornerRadius="14dp"
                app:cardElevation="0dp">

                <LinearLayout android:layout_width="match_parent" android:layout_height="52dp"
                    android:orientation="horizontal" android:gravity="center_vertical"
                    android:paddingHorizontal="16dp">
                    <TextView android:layout_width="0dp" android:layout_height="wrap_content"
                        android:layout_weight="1" android:text="Last Login"
                        android:textSize="14sp" android:textColor="@color/text_muted" />
                    <TextView android:id="@+id/tvLastLogin"
                        android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="Today" android:textSize="14sp" android:textStyle="bold"
                        android:textColor="@color/text_primary" />
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- ── LOGOUT BUTTON ────────────────────────────── -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnLogout"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:text="↩  Sign Out"
                android:textSize="15sp"
                android:textStyle="bold"
                android:textColor="@color/danger"
                android:backgroundTint="#1A0808"
                app:cornerRadius="12dp"
                app:strokeColor="@color/border_danger"
                app:strokeWidth="1dp"
                style="@style/Widget.MaterialComponents.Button" />

        </LinearLayout>
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
